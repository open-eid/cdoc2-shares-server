<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Generated OpenAPI model/api code is not hand-written; exclude it from analysis -->
    <Match>
        <Package name="~.*\.generated(\..*)?"/>
    </Match>

    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
